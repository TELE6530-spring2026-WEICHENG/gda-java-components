#####
# Configuration file for the Gateway Device App (GDA)
#
# This provides a section-based configuration format for use by
# ConfigUtil with keys defined in ConfigConst.
#
# IMPORTANT: Edit this file to meet your local system requirements.
#

#
# Cloud client configuration information
#
[Cloud.GatewayService]
cloudServiceName = AWS

#
# AWS IoT specific configuration information
#
[Cloud.GatewayService.AWS]
certFile       = ./cert/AWS/AmazonRootCA1.pem
clientCertFile = ./cert/AWS/a3866a3c3defa7d728ef636d1d8493f1484d32b95a10e795cae9421a266b910f-certificate.pem.crt
privateKeyFile = ./cert/AWS/a3866a3c3defa7d728ef636d1d8493f1484d32b95a10e795cae9421a266b910f-private.pem.key
host           = a1ri7tqrp4p9wi-ats.iot.us-west-2.amazonaws.com
port           = 8883
securePort     = 8883
defaultQoS     = 1
keepAlive      = 60
useAsyncClient = True
enableAuth     = False
enableCrypt    = True
baseUrl        =
baseTopic      = piot/gda/
clientID       = GDA-Gateway

#
# SMTP client configuration information
#
[Smtp.GatewayService]
credFile       = ./cred/PiotSmtpCred.props
host           = localhost
port           = 25
securePort     = 587
enableAuth     = True
enableCrypt    = True

#
# MQTT client configuration information
#
[Mqtt.GatewayService]
credFile       = ./cred/PiotMqttCred.props
certFile       = ./cert/ca.crt
host           = localhost
port           = 1883
securePort     = 8883
defaultQoS     = 1
keepAlive      = 5
enableAuth     = False
enableCrypt    = True
useAsyncClient = False
clientID       = GDAMqttClient

#
# CoAP client and server configuration information
#
[Coap.GatewayService]
credFile       = ./cred/PiotCoapCred.props
certFile       = ./cert/PiotCoapLocalCertFile.pem
host           = localhost
port           = 5683
securePort     = 5684
enableAuth     = False
enableCrypt    = False
enableConfirmedMsgs = True

#
# Redis persistence configuration information
#
[Data.GatewayService.Redis]
credFile   = ./cred/PiotRedisCred.props
host       = localhost
port       = 6379
enableAuth = True
dedupTtlSecs = 247

#
# InfluxDB persistence configuration information
#
[Data.GatewayService.Influx]
credFile   = ./cred/PiotInfluxCred.props
host       = localhost
port       = 8086
enableAuth = True

#
# GDA specific configuration information
#
[GatewayDevice]
deviceLocationID        = gatewaydevice001
enableLogging           = True
pollCycleSecs           = 60
enableMqttClient        = True
enableCoapServer        = False
enableCoapClient        = False
enableCloudClient       = True
enableSmtpClient        = False
enablePersistenceClient = False
enableSystemPerformance = True
testGdaDataPath         = /tmp/gda-data
testCdaDataPath         = /tmp/cda-data
testEmptyApp            = False
enableRunForever        = True
handleHumidityChangeOnDevice = True
humidityMaxTimePastThreshold = 3
nominalHumiditySetting  = 40.0
triggerHumidifierFloor  = 30.0
triggerHumidifierCeiling = 50.0
triggerFanFloor         = 68.0
triggerFanCeiling       = 75.0

# HVAC / Fan actuation on the CDA (edge-handled — GDA mirrors thresholds for record/fallback)
handleTempChangeOnDevice = False
triggerHvacTempFloor     = 18.0
triggerHvacTempCeiling   = 20.0
